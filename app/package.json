{
  "name": "rpiledconfig",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'scripts/*.mjs' '*.{js,mjs,mts}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'scripts/*.mjs' '*.{js,mjs,mts}'",
    "test": "vitest run",
    "version:check": "node scripts/version-check.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^8.0.1",
    "@babel/plugin-transform-shorthand-properties": "^8.0.1",
    "@babel/plugin-transform-template-literals": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/runtime": "^8.1.0",
    "@eslint/js": "10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
