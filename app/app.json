{
  "expo": {
    "name": "RPi LED Config",
    "slug": "rpiledconfig",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "rpiledconfig",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d110e",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tomcully.rpiledconfig",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "RPi LED Config uses Bluetooth to talk to the Raspberry Pi whose LED you have read. Nothing else is scanned or stored.",
        "NSCameraUsageDescription": "RPi LED Config uses the camera to read the blinking LED on your Raspberry Pi, and a WiFi QR code when you choose to scan one. Nothing is recorded and no image leaves the phone."
      }
    },
    "android": {
      "package": "com.tomcully.rpiledconfig",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 300,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "RPi LED Config uses the camera to read the blinking LED on your Raspberry Pi, and a WiFi QR code when you choose to scan one. Nothing is recorded and no image leaves the phone.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "RPi LED Config uses Bluetooth to talk to the Raspberry Pi whose LED you have read. Nothing else is scanned or stored."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d110e",
          "dark": {
            "backgroundColor": "#0d110e",
            "image": "./assets/splash-icon.png"
          },
          "resizeMode": "contain",
          "imageWidth": 200,
          "image": "./assets/splash-icon.png"
        }
      ],
      "./plugins/withDebuggableRelease"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
