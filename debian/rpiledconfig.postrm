#!/bin/sh
#
# RPiLEDConfig - daemon
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the Apache License, Version 2.0 - see LICENSE
#
# rpiledconfig postrm.
#
# remove keeps the configuration; purge deletes it, as Debian expects of a purge. The
# daemon keeps no state: the pairing key is in memory only. The system user and group are
# left, as Debian policy advises: files they own may remain elsewhere.

set -e

case "$1" in
    remove)
        if [ -S /run/udev/control ] && command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
        fi
        ;;

    purge)
        # dpkg has removed the conffile; anything left beside it (.dpkg-old, .dpkg-dist,
        # an operator's notes) goes with the directory.
        rm -rf /etc/rpiledconfig
        ;;
esac

#DEBHELPER#

exit 0
