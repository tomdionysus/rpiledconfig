#!/usr/bin/make -f
#
# RPiLEDConfig - daemon
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the Apache License, Version 2.0 - see LICENSE
#
# The CMake project is in daemon/; its install rules say where everything goes.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
TESTS = OFF
else
TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake --sourcedirectory=daemon --builddirectory=debian/build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DRPILEDCONFIG_BUILD_TESTING=$(TESTS)

# The test binary rather than ctest, with a private bus of its own for the D-Bus tests:
# the system bus is never touched.
override_dh_auto_test:
ifeq ($(TESTS),ON)
	dbus-run-session -- sh -c 'RPILEDCONFIG_TEST_DBUS_ADDRESS="$$DBUS_SESSION_BUS_ADDRESS" exec debian/build/rpiledconfig_tests'
endif

# rpiledconfig-uninstall.service is left out on purpose. It runs the purge of this package,
# and a prerm that stopped it would stop the removal it is in the middle of.
override_dh_installsystemd:
	dh_installsystemd rpiledconfig.service

# The unit and postinst point at the docs by their names, so they stay uncompressed.
override_dh_compress:
	dh_compress -X.md -X.conf
