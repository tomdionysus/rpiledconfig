#!/bin/sh
#
# RPiLEDConfig - daemon
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the Apache License, Version 2.0 - see LICENSE
#
# rpiledconfig postinst: the service account, its directories, udev, the netdev group, and
# the unit.
#
# debhelper adds what enables the unit and starts it: the packaged configuration
# is the Pi's (the real LED, BlueZ, NetworkManager), and a Pi that has just had this
# installed is a Pi somebody wants to set up. An upgrade restarts it unless it was disabled.

set -e

USER_NAME=rpiledconfig
OLD_STATE_DIR=/var/lib/rpiledconfig
CONFIG_DIR=/etc/rpiledconfig
CONFIG_FILE=$CONFIG_DIR/rpiledconfig.conf

# chown and chmod, unless the administrator has registered an override with
# dpkg-statoverride, which wins.
set_perms() {
    owner=$1
    mode=$2
    path=$3

    if ! dpkg-statoverride --list "$path" >/dev/null 2>&1; then
        chown "$owner" "$path"
        chmod "$mode" "$path"
    fi
}

case "$1" in
    configure)
        if ! getent group "$USER_NAME" >/dev/null; then
            addgroup --system --quiet "$USER_NAME"
        fi

        if ! getent passwd "$USER_NAME" >/dev/null; then
            adduser --system --quiet --ingroup "$USER_NAME" --home /nonexistent \
                --no-create-home --shell /usr/sbin/nologin "$USER_NAME"
        fi

        # Versions before protocol 4 kept a machine id here. The key is one-time and in
        # memory now, so an upgrade deletes what is left of it.
        rm -rf "$OLD_STATE_DIR"

        # The service may read its configuration and not change it. dpkg unpacks it
        # root:root 0644 on every upgrade that replaces it, so this runs every time.
        set_perms "root:$USER_NAME" 0750 "$CONFIG_DIR"
        if [ -f "$CONFIG_FILE" ]; then
            set_perms "root:$USER_NAME" 0640 "$CONFIG_FILE"
        fi

        # The LED's rule, applied to the LED that is already there. Not inside a
        # container, where there is no udev to tell.
        if [ -S /run/udev/control ] && command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=leds --action=change || true
        fi

        # The unit's SupplementaryGroups=netdev is how the service reaches wpa_supplicant's
        # control socket for Wi-Fi Easy Connect, and systemd refuses to start a unit that
        # names a group which does not exist. Raspberry Pi OS has netdev; a minimal Debian
        # may not, and an empty group there costs nothing.
        if ! getent group netdev >/dev/null; then
            addgroup --system --quiet netdev
        fi
        ;;
esac

#DEBHELPER#

if [ "$1" = "configure" ] && [ -z "${2:-}" ] && [ -d /run/systemd/system ]; then
    echo "rpiledconfig is installed, enabled and started."
    echo "See /usr/share/doc/rpiledconfig/security.md for what that exposes."
fi

exit 0
