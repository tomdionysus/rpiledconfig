root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The daemon's C++ is formatted by daemon/.clang-format; this only keeps an editor from
# fighting it.
[*.{cpp,h}]
max_line_length = 160

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.sh]
indent_size = 4

[{debian/rules,Makefile}]
indent_style = tab
