# Licensed under the Apache License, Version 2.0 - see LICENSE
#
# rpiledconfig prerm: stop the service on removal. Not on an upgrade: the old binary
# keeps running until postinst restarts the new one, so the daemon is down for a restart
# rather than for the whole unpack.

set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop rpiledconfig.service >/dev/null || true
fi

exit 0
