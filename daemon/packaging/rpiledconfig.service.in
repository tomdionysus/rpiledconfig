#
# RPiLEDConfig - daemon
#
# Copyright (C) 2026 T. Cully
# Licensed under the Apache License, Version 2.0 - see LICENSE
#
# The daemon answers to anyone in Bluetooth range who can see its LED, so this unit
# assumes it will one day be attacked. It runs as its own unprivileged user, writes to the
# LED's sysfs node and nothing else, keeps no state, and reaches nothing on
# the network: BlueZ and NetworkManager are talked to over the system bus, and the bus does
# the rest.
#
# Generated by CMake from packaging/rpiledconfig.service.in - edit that, not the installed
# copy, and change the installed copy with "systemctl edit rpiledconfig" rather than in
# place.
#
# What the service user needs from the rest of the system, and where it comes from:
# BlueZ's own bus policy lets any user register a GATT application and an advertisement,
# and NetworkManager's lets any user call it, so the package ships no bus policy; the
# polkit rule (60-rpiledconfig.rules) lets this user alone scan, add, activate and delete
# NetworkManager connections; the udev rule (60-rpiledconfig.rules in udev's directory)
# gives its group the LED's brightness and trigger; the netdev group (below) opens
# wpa_supplicant's control socket for Wi-Fi Easy Connect.

[Unit]
Description=RPiLEDConfig daemon
Documentation=file:@CMAKE_INSTALL_FULL_DOCDIR@/installation.md
# Both are needed and both are on every Raspberry Pi OS; naming one that is not installed
# does nothing.
After=bluetooth.service NetworkManager.service dbus.service
Wants=bluetooth.service NetworkManager.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/rpiledconfig --config @RPILEDCONFIG_CONFIG_INSTALL_DIR@/rpiledconfig.conf

User=rpiledconfig
Group=rpiledconfig

# wpa_supplicant's control socket, /run/wpa_supplicant/wlan0, is root:netdev 0770 where
# NetworkManager starts wpa_supplicant (GROUP=netdev), and Wi-Fi Easy Connect talks to it.
# The daemon's own end of that socket is an abstract name the kernel picks, not a file:
# PrivateTmp below would hide a client socket in /tmp from wpa_supplicant, which replies to
# the client's address in its own mount namespace, and an abstract name belongs to the
# network namespace this unit shares. So there is no RuntimeDirectory for it either. The
# package makes the group if the system has none (postinst).
SupplementaryGroups=netdev

# /etc/rpiledconfig. systemd never chowns a configuration directory, so the package makes
# it root:rpiledconfig: the service reads its configuration and cannot change it. Read
# only: ProtectSystem=strict covers /etc.
ConfigurationDirectory=rpiledconfig
ConfigurationDirectoryMode=0750

Restart=on-failure
RestartSec=5s

# SIGTERM is what systemd sends and what the daemon stops cleanly on: it gives the LED its
# trigger back and takes the advertisement down before it exits.
KillSignal=SIGTERM
TimeoutStopSec=10s

MemoryMax=64M
TasksMax=32
LimitNOFILE=1024

# Hardening, as corvus-gateway has it, with one difference for the LED.
#
# ProtectKernelTunables makes all of /sys read-only in the service's mount namespace, and
# the LED's brightness and trigger are under /sys. /sys/class/leds/ACT is not where they
# are, though: it is a symlink into /sys/devices (/sys/devices/platform/leds/leds/ACT on a
# Pi 4 and 5, and led0 beside it on older boards, all children of the device tree's
# gpio-leds node "leds"). A write follows the symlink and lands in the read-only /sys, so
# ReadWritePaths=/sys/class/leds (a real directory of symlinks) opens nothing. The real
# directory is what is made writable, and "-" lets the unit start on a machine without it.
# An LED elsewhere (led.path) needs its own resolved directory here, through
# "systemctl edit rpiledconfig".
#
# Writable in the namespace is not writable to this user: the udev rule gives the service's
# group brightness and trigger and nothing else, and every other file there stays root's.
NoNewPrivileges=yes
PrivateTmp=yes
# /dev is reduced to the pseudo devices. Nothing here opens a device: the radios are
# BlueZ's and NetworkManager's, reached over the bus socket in /run, which PrivateDevices
# leaves alone. getrandom(2) needs no /dev/urandom, and OpenSSL's fallback to it still
# finds it.
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=-/sys/devices/platform/leds/leds
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

# A Unix socket for the system bus, which is how BlueZ and NetworkManager are reached, and
# nothing else: sd-bus needs no netlink, the hostname comes from uname(2), and there is no
# IP at all, because the daemon configures the network and never uses it.
RestrictAddressFamilies=AF_UNIX

# No capabilities at all. The LED is a file this user may write, and the radios belong to
# BlueZ and NetworkManager.
CapabilityBoundingSet=
AmbientCapabilities=

# sd-bus over Asio needs socket, connect, sendmsg, recvmsg and getsockopt (@network-io),
# epoll and eventfd (@io-event), timerfd (@timer), and clone3 for the io thread
# (@process): all in @system-service, none in the groups taken away.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
