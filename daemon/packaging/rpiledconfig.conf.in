#
# The installed configuration. Generated by CMake from packaging/rpiledconfig.conf.in,
# which is config/rpiledconfig.example.conf with the defaults a Pi wants: the real LED,
# BlueZ and NetworkManager. The example, with every key explained, is in
# @CMAKE_INSTALL_FULL_DOCDIR@.
#
# The package marks this file a conffile: an upgrade never overwrites your changes, and
# asks what to do when the packaged version has changed too.
#
# After editing:
#   sudo systemctl restart rpiledconfig

# debug, info, warn or error. Lines go to the journal: journalctl -u rpiledconfig
log.level: info

# The activity LED, the main one: ACT, or led0 on older boards. For the power LED use
# /sys/class/leds/PWR (led1 on older boards).
led.driver: sysfs
led.path: /sys/class/leds/ACT

# BLE through BlueZ, on this adapter.
ble.driver: bluez
ble.adapter: hci0

# The start of the name this Pi advertises and the app lists: <prefix>-<4 random hex>. At
# most 24 printable ASCII characters.
ble.name_prefix: RPiLEDConfig

# BlueZ gives the Bluetooth adapter's name to anything that connects, with no key, and by default
# that name is this Pi's hostname. true gives the adapter the advertised name while it advertises
# and hands its own name back when that stops, so the hostname does not go over Bluetooth. This
# changes a system-wide Bluetooth setting while it lasts, so it is off by default.
# status.report_hostname is separate: it is what the service itself tells the app.
ble.hide_adapter_name: false

# WiFi through NetworkManager, and Wi-Fi Easy Connect through wpa_supplicant on this
# interface.
wifi.driver: networkmanager
wifi.interface: wlan0
wifi.easyconnect: wpa_supplicant

# What a phone's "remove from this Pi" does: systemd purges this package (through
# rpiledconfig-uninstall.service), fake only logs, off refuses.
uninstall.driver: systemd

# Be in setup mode, advertising over Bluetooth, for as long as the service runs, whether or not
# the Pi has WiFi. false advertises only while the Pi has no WiFi connection, for setup.timeout
# seconds at a time, checking WiFi every setup.recheck seconds otherwise. docs/security.md says what
# this exposes.
setup.always: true
setup.timeout: 900
setup.recheck: 60

# Whether the app is told this Pi's hostname. When false it shows the one-time key instead, with a
# notice. This is status only: BlueZ still gives the adapter's name to anything connected unless
# ble.hide_adapter_name is also true.
status.report_hostname: true

# Stop the service this many minutes after the system boots, until the next boot: it then no longer
# answers over Bluetooth at all, and to change a Pi's network it has to be powered off and on. 0
# runs continuously. Default 0.
service.stop_after_boot_minutes: 0
